#version 430 core

struct Particle
{
    vec2 position;
    vec2 velocity;
};

layout(std430, binding = 0) readonly buffer Particles
{
    Particle particles[];
};

void main()
{
    vec2 position = particles[gl_VertexID].position;

    gl_Position = vec4(position, 0.0, 1.0);

    gl_PointSize = 1.0;
}